# Local values. Use distinct databases and signing keys in every environment.
APP_ENV=development
PORT=8000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=guidance_portal_local
API_TOKEN_ISSUER=guidance-portal-frontend
API_TOKEN_AUDIENCE=guidance-portal-api
# Base64-encoded RSA public key corresponding to the frontend's private key.
API_TOKEN_PUBLIC_KEY_B64=
